# Normalize line endings for everything git detects as text
* text=auto

# Read inside Linux containers, where CRLF breaks them
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.conf          text eol=lf
.env.example    text eol=lf

# CSVs are test input: byte-exact, so BOMs, CRLF and SHA-256 survive a checkout
*.csv           -text

# Binary
*.pdf           binary
*.png           binary
*.jpg           binary
*.ico           binary

# Generated: collapsed in diffs
contracts/openapi.json                                 linguist-generated
web/src/app/core/api/**                                linguist-generated
src/Meridian.Api/Shared/Data/Migrations/*.Designer.cs  linguist-generated
src/Meridian.Api/Shared/Data/Migrations/*ModelSnapshot.cs  linguist-generated
