# Copy to .env (git-ignored) and adjust. The values below work as they are for
# `docker compose up --build` with the local postgres and azurite containers.

# --- Local postgres container ------------------------------------------------
# Must match the user, password and database in ConnectionStrings__Default.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian

# --- Database ----------------------------------------------------------------
ConnectionStrings__Default=Host=postgres;Port=5432;Database=meridian;Username=meridian;Password=change-me
# Azure: Host=<server>.postgres.database.azure.com;Port=5432;Database=meridian;Username=<user>;Password=<password>;SslMode=Require

# --- Blob storage ------------------------------------------------------------
# Azure: set the container SAS URL. It wins over the connection string below.
# The container must already exist (a container SAS can't create it), the SAS
# needs read, add, create, write and list, and it must outlast the run.
Storage__ContainerSasUrl=

# Azurite only. Inside a container UseDevelopmentStorage=true means the
# container itself, so the azurite service is named explicitly. The key is
# Azurite's public, fixed development key, not a secret.
Storage__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
Storage__Container=imports

# --- Telemetry ---------------------------------------------------------------
# Empty: console logs only.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Worker ------------------------------------------------------------------
# Worker__Enabled is set per service in docker-compose.yml (api false, worker
# true).
Worker__Concurrency=2
Worker__PollIntervalMs=2000

# --- Seeding -----------------------------------------------------------------
Seed__MemberStatesPath=/seed/member_states.csv

# --- Uploads -----------------------------------------------------------------
Upload__MaxBytes=200000000
