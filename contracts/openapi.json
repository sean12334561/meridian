  "components": {
    "schemas": {
      "ConflictDto": {
        "required": [
          "id",
          "voteId",
          "voteRef",
          "voteTitle",
          "target",
          "status",
          "approvedValue",
          "approvedSource",
          "proposedValue",
          "proposedSource",
          "createdAt",
          "decidedByName",
          "decidedAt",
          "note"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "voteId": {
            "type": "integer",
            "format": "int64"
          },
          "voteRef": {
            "type": "string"
          },
          "voteTitle": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConflictStatus"
          },
          "approvedValue": {
            "type": "string"
          },
          "approvedSource": {
            "$ref": "#/components/schemas/ConflictSourceDto"
          },
          "proposedValue": {
            "type": "string"
          },
          "proposedSource": {
            "$ref": "#/components/schemas/ConflictSourceDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedByName": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConflictSourceDto": {
        "required": [
          "importId",
          "fileName",
          "uploadedByName",
          "uploadedAt",
          "line",
          "publishedAt"
        ],
        "type": "object",
        "properties": {
          "importId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "uploadedByName": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "line": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "publishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ConflictStatus": {
        "enum": [
          "Pending",
          "Accepted",
          "Rejected",
          "Superseded"
        ]
      },
      "Decision": {
        "enum": [
          "Accept",
          "Reject",
          null
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportCreatedDto": {
        "required": [
          "importId"
        ],
        "type": "object",
        "properties": {
          "importId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImportDto": {
        "required": [
          "id",
          "fileName",
          "uploadedByName",
          "uploadedAt",
          "status",
          "phase",
          "processedRows",
          "totalRows",
          "error",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "uploadedByName": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ImportStatus"
          },
          "phase": {
            "$ref": "#/components/schemas/ImportPhase"
          },
          "processedRows": {
            "type": "integer",
            "format": "int32"
          },
          "totalRows": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ImportPhase": {
        "enum": [
          "Queued",
          "Parsing",
          "Checking",
          "Applying",
          "Done"
        ]
      },
      "ImportReportDto": {
        "required": [
          "totals",
          "conflictsOpened",
          "votes"
        ],
        "type": "object",
        "properties": {
          "totals": {
            "$ref": "#/components/schemas/ImportReportTotals"
          },
          "conflictsOpened": {
            "type": "integer",
            "format": "int32"
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoteReportDto"
            }
          }
        }
      },
      "ImportReportTotals": {
        "required": [
          "rows",
          "new",
          "unchanged",
          "duplicate",
          "invalid",
          "contradiction",
          "conflict",
          "previouslyDecided",
          "alreadyPending",
          "normalized"
        ],
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer",
            "format": "int32"
          },
          "new": {
            "type": "integer",
            "format": "int32"
          },
          "unchanged": {
            "type": "integer",
            "format": "int32"
          },
          "duplicate": {
            "type": "integer",
            "format": "int32"
          },
          "invalid": {
            "type": "integer",
            "format": "int32"
          },
          "contradiction": {
            "type": "integer",
            "format": "int32"
          },
          "conflict": {
            "type": "integer",
            "format": "int32"
          },
          "previouslyDecided": {
            "type": "integer",
            "format": "int32"
          },
          "alreadyPending": {
            "type": "integer",
            "format": "int32"
          },
          "normalized": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ImportRowDto": {
        "required": [
          "lineNo",
          "rawText",
          "voteRef",
          "countryCode",
          "ballot",
          "outcome",
          "reason",
          "normalizations",
          "conflictId"
        ],
        "type": "object",
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32"
          },
          "rawText": {
            "type": "string"
          },
          "voteRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "countryCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "ballot": {
            "maxLength": 1,
            "minLength": 1,
            "type": [
              "null",
              "string"
            ],
            "format": "char"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RowOutcome"
              }
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "normalizations": {
            "type": [
              "null",
              "string"
            ]
          },
          "conflictId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          }
        }
      },
      "ImportStatus": {
        "enum": [
          "Pending",
          "Running",
          "Completed",
          "Failed"
        ]
      },
      "PagedResultOfConflictDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConflictDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PagedResultOfImportRowDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
